/* ===========================================================================
 * rofi/window.rasi.template — matugen template for the rofi window switcher
 * (rofi 2.1.1 theme syntax, rofi-theme(5))
 *
 * matugen fills the colour placeholders in `*` from the wallpaper palette and
 * writes rofi/window.rasi (generated: do not edit by hand). The theme draws one
 * horizontal row of window thumbnails with the window name under each.
 * =========================================================================== */

/* configuration: rofi options as theme properties.
 *   modi              modes to load ("window" = window switcher)
 *   window-thumbnail  true shows a window thumbnail as the entry icon (rofi
 *                     -window-thumbnail)
 *   show-icons        true loads icons from the icon theme
 *   display-window    prompt/label template for the window mode; {name} = title */

configuration {
    modi:             "window";
    window-thumbnail: true;
    show-icons:       false;
    display-window:   "{name}";
}

/* `*` — palette variables (bg, bg-alt, fg, fg-dim, primary, border-col, sel-bg,
 * sel-border; the last two are the primary colour + 20/60 hex alpha) and the
 * defaults every widget inherits: background-color, text-color, font. */
* {
    bg:          {{ colors.surface.dark.hex }};
    bg-alt:      {{ colors.surface_variant.dark.hex }};
    fg:          {{ colors.on_surface.dark.hex }};
    fg-dim:      {{ colors.on_surface_variant.dark.hex }};
    primary:     {{ colors.primary.dark.hex }};
    border-col:  {{ colors.outline_variant.dark.hex }};
    sel-bg:      {{ colors.primary.dark.hex }}20;
    sel-border:  {{ colors.primary.dark.hex }}60;

    background-color: transparent;
    text-color:       @fg;
    font:             "JetBrainsMono Nerd Font Propo 12";
}

/* window: the popup. width 92% of the monitor, 260px high, centred (location =
 * place of the anchor on the monitor, anchor = anchor point on the window). */
window {
    background-color: @bg;
    border:           2px;
    border-color:     @border-col;
    border-radius:    14px;
    padding:          14px;
    width:            92%;
    height:           260px;
    location:         center;
    anchor:           center;
}

/* mainbox: only the listview (no input bar, no prompt) */
mainbox {
    background-color: transparent;
    children:         [ "listview" ];
    spacing:          0;
}

/* listview: columns = entries per row, lines = rows (1 = single horizontal row),
 * flow horizontal, fixed-height keeps the row height when fewer entries exist,
 * scrollbar false hides the scrollbar. */
listview {
    background-color: transparent;
    flow:             horizontal;
    lines:            1;
    columns:          10;
    spacing:          10px;
    padding:          4px;
    scrollbar:        false;
    fixed-height:     true;
}

/* element: one window card: vertical stack of thumbnail and name, 180px wide. */
element {
    background-color: transparent;
    border:           2px;
    border-color:     transparent;
    border-radius:    10px;
    orientation:      vertical;
    padding:          8px;
    spacing:          6px;
    cursor:           pointer;
    width:            180px;
}

/* element selected: highlighted card (translucent primary fill and border). */
element selected {
    background-color: @sel-bg;
    border-color:     @sel-border;
}

/* element-thumbnail: the window thumbnail, 160px. */
element-thumbnail {
    border-radius:    6px;
    size:             160px;
}

/* element-text: window name, centred; highlight none disables match highlighting. */
element-text {
    background-color: transparent;
    text-color:       @fg-dim;
    horizontal-align: 0.5;
    vertical-align:   0.5;
    padding:          2px 4px 0;
    highlight:        none;
}

/* Name of the selected card uses the main text colour. */
element selected element-text {
    text-color: @fg;
}

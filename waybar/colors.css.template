/* waybar/colors.css.template — matugen template for the waybar palette.
 * matugen fills each colors.<role>.dark.hex placeholder with the dark-scheme colour of
 * the current wallpaper and writes waybar/colors.css (generated: do not edit by hand).
 * waybar/style.css reads the names below through @primary, @surface, etc. */
@define-color primary         {{ colors.primary.dark.hex }};
@define-color on_primary      {{ colors.on_primary.dark.hex }};
@define-color surface         {{ colors.surface.dark.hex }};
@define-color on_surface      {{ colors.on_surface.dark.hex }};
@define-color on_surface_var  {{ colors.on_surface_variant.dark.hex }};
@define-color tertiary        {{ colors.tertiary.dark.hex }};
@define-color error           {{ colors.error.dark.hex }};
@define-color outline_var     {{ colors.outline_variant.dark.hex }};

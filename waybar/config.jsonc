// ===========================================================================
// waybar/config.jsonc — Waybar configuration (waybar 0.16.0, JSON with // comments)
//
// Linked to ~/.config/waybar/ by modules/components/bar/waybar.nix. Styling is in
// style.css; the palette in colors.css. Custom modules ("custom/<name>") run
// the commands below, or the scripts in ~/.config/hypr/waybar/scripts/.
//
// Custom-module keys used here (waybar-custom(5)):
//   exec / exec-if      command to run / condition (exit 0 = run it)
//   return-type "json"  exec prints one JSON line: text, alt, tooltip, class, percentage
//   interval            seconds between runs; "once" = a single run at startup
//   format              "{}" shows the text field
//   on-click, on-click-right, on-scroll-up, on-scroll-down   commands for the events
//   tooltip, escape     tooltip on/off; escape Pango markup in the output
// ===========================================================================
{
    // Bar window: layer (top = in front of windows), position (top, bottom, left,
    // right), height in px, margin-* around the bar, spacing between modules,
    // fixed-center keeps modules-center centred.
    "layer": "top",
    "position": "top",
    "height": 44,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 0,
    "fixed-center": true,
    // Module lists for the left, centre and right of the bar.
    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces",
        "custom/browser",
        "custom/terminal",
        "custom/files",
        "custom/window-sep",
        "hyprland/window",
        "custom/media-sep",
        "custom/media-prev",
        "custom/media-play",
        "custom/media-next",
        "custom/media-scroll"
    ],
    "modules-center": [
        "custom/clock"
    ],
    "modules-right": [
        "custom/battlenet",
        "tray",
        "custom/sep",
        "custom/weather",
        "custom/sep",
        "custom/volume",
        "custom/sep-battery",
        "battery",
        "custom/sep-battery",
        "custom/updates",
        "custom/sep",
        "custom/notification",
        "custom/sep",
        "custom/layout",
        "custom/sep",
        "custom/power"
    ],
    // Workspaces: icon format, scroll switches workspace (replaces the default
    // cycling), persistent-workspaces always shows 1-3 (on DP-3 and every other
    // output), all-outputs false limits the group to the bar's own output.
    "hyprland/workspaces": {
        "format": "{icon}",
        "all-outputs": false,
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1",
        "format-icons": {
            "1": "1",
            "2": "2",
            "3": "3"
        },
        "persistent-workspaces": {
            "DP-3": [1, 2, 3],
            "*": [1, 2, 3]
        }
    },
    // Active window title: max-length 25 characters, separate-outputs shows the
    // active window of the bar's own monitor.
    "hyprland/window": {
        "format": "{}",
        "max-length": 25,
        "separate-outputs": true
    },
    // Launcher and pinned apps: a glyph from an echoed JSON line; click starts the app.
    "custom/launcher": {
        "format": "{}",
        "tooltip": false,
        "on-click": "wofi --show drun",
        "return-type": "json",
        "exec": "echo '{\"text\":\"󰍜\"}'"
    },
    "custom/browser": {
        "format": "{}",
        "on-click": "firefox",
        "return-type": "json",
        "exec": "echo '{\"text\":\"󰖟\",\"tooltip\":\"Firefox\"}'"
    },
    "custom/terminal": {
        "format": "{}",
        "on-click": "kitty",
        "return-type": "json",
        "exec": "echo '{\"text\":\"󰆍\",\"tooltip\":\"Kitty\"}'"
    },
    "custom/files": {
        "format": "{}",
        "on-click": "nautilus",
        "return-type": "json",
        "exec": "echo '{\"text\":\"󰉋\",\"tooltip\":\"Nautilus\"}'"
    },
    // Media: scrolling ticker (scripts/media-scroll.sh), previous / play-pause / next
    // buttons; every media module is hidden by exec-if unless a player is Playing
    // or Paused.
    "custom/media-scroll": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.config/hypr/waybar/scripts/media-scroll.sh",
        "interval": 1,
        "exec-if": "playerctl status 2>/dev/null | grep -qE 'Playing|Paused'",
        "tooltip": false,
        "on-scroll-up": "playerctl previous",
        "on-scroll-down": "playerctl next"
    },
    "custom/media-prev": {
        "format": "{}",
        "return-type": "json",
        "exec": "echo '{\"text\":\"󰒮\",\"tooltip\":\"Previous\"}'",
        "exec-if": "playerctl status 2>/dev/null | grep -qE 'Playing|Paused'",
        "on-click": "playerctl previous",
        "interval": 2
    },
    "custom/media-play": {
        "format": "{}",
        "return-type": "json",
        "exec": "playerctl status 2>/dev/null | grep -q Playing && echo '{\"text\":\"󰏤\",\"tooltip\":\"Pause\"}' || echo '{\"text\":\"󰐊\",\"tooltip\":\"Play\"}'",
        "exec-if": "playerctl status 2>/dev/null | grep -qE 'Playing|Paused'",
        "on-click": "playerctl play-pause",
        "interval": 2
    },
    "custom/media-next": {
        "format": "{}",
        "return-type": "json",
        "exec": "echo '{\"text\":\"󰒭\",\"tooltip\":\"Next\"}'",
        "exec-if": "playerctl status 2>/dev/null | grep -qE 'Playing|Paused'",
        "on-click": "playerctl next",
        "interval": 2
    },
    // Clock (scripts/clock.sh), refreshed every second; tooltip is the month calendar.
    "custom/clock": {
        "format": "{}",
        "return-type": "json",
        "interval": 1,
        "exec": "~/.config/hypr/waybar/scripts/clock.sh",
        "tooltip": true
    },
    // System tray: icon size and spacing in px.
    "tray": {
        "icon-size": 16,
        "spacing": 8
    },
    // Battle.net button (scripts/battlenet.sh): shown while Battle.net.exe runs;
    // click focuses the window, right click closes it.
    "custom/battlenet": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.config/hypr/waybar/scripts/battlenet.sh",
        "exec-if": "pgrep -f 'Battle.net.exe' >/dev/null 2>&1",
        "interval": 3,
        "on-click": "hyprctl dispatch focuswindow class:steam_app_0",
        "on-click-right": "~/.config/hypr/waybar/scripts/battlenet.sh close"
    },
    // Volume (scripts/volume.sh): click toggles mute, scroll changes 5%
    // (raising is capped at 100% by --limit 1.0).
    "custom/volume": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.config/hypr/waybar/scripts/volume.sh",
        "interval": 2,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume --limit 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },
    // Battery (waybar-battery(5)): bat/adapter name the /sys/class/power_supply
    // entries; states adds CSS classes .warning (<= 30%) and .critical (<= 15%);
    // format-* per status ({icon} picked from format-icons by capacity).
    "battery": {
        "bat": "BAT0",
        "adapter": "ADP0",
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-full": "󰁹 Full",
        "format-not-present": "",
        "format-icons": [
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "tooltip-format": "{timeTo} — {capacity}%",
        "tooltip-format-not-present": ""
    },
    // Weather (scripts/weather.sh), every 30 minutes; exec-if checks ipinfo.io is reachable.
    "custom/weather": {
        "format": "{}",
        "return-type": "json",
        "tooltip": true,
        "interval": 1800,
        "exec": "~/.config/hypr/waybar/scripts/weather.sh",
        "exec-if": "curl -sf --max-time 2 ipinfo.io/city &>/dev/null"
    },
    // Pending rebuild indicator (scripts/updates.sh), hourly.
    "custom/updates": {
        "format": "{}",
        "return-type": "json",
        "tooltip": true,
        "interval": 3600,
        "exec": "~/.config/hypr/waybar/scripts/updates.sh"
    },
    // Notification centre (swaync): `swaync-client -swb` streams state as JSON; the
    // icon comes from format-icons by alt (notification / none, with dnd- and
    // inhibited- prefixes). Click toggles the panel, right click toggles Do Not Disturb.
    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "󱅫",
            "none": "󰂚",
            "dnd-notification": "󱅫",
            "dnd-none": "󰂛",
            "inhibited-notification": "󱅫",
            "inhibited-none": "󰂚",
            "dnd-inhibited-notification": "󱅫",
            "dnd-inhibited-none": "󰂛"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    // Power button: opens the power menu.
    "custom/power": {
        "format": "󰐥",
        "tooltip": false,
        "on-click": "~/.config/hypr/scripts/powermenu.sh"
    },
    // Separators: custom/sep is a static "|"; the -battery, window and media
    // variants appear only when their exec-if holds (a battery exists, a window
    // has focus, a player is active).
    "custom/sep": {
        "format": "|",
        "interval": "once",
        "tooltip": false
    },
    "custom/sep-battery": {
        "format": "{}",
        "exec": "echo '|'",
        "exec-if": "test -d /sys/class/power_supply/BAT0 || test -d /sys/class/power_supply/BAT1",
        "interval": "once",
        "tooltip": false
    },
    "custom/window-sep": {
        "format": " | ",
        "return-type": "json",
        "exec": "echo '{\"text\":\" | \"}'",
        "exec-if": "hyprctl activewindow 2>/dev/null | grep -q 'class:'",
        "interval": 2,
        "tooltip": false
    },
    "custom/media-sep": {
        "format": " | ",
        "return-type": "json",
        "exec": "echo '{\"text\":\" | \"}'",
        "exec-if": "playerctl status 2>/dev/null | grep -qE 'Playing|Paused'",
        "interval": 2,
        "tooltip": false
    },
    // Hyprland layout indicator (scripts/layout.sh); click cycles the layout.
    "custom/layout": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.config/hypr/waybar/scripts/layout.sh",
        "on-click": "~/.config/hypr/waybar/scripts/layout.sh cycle",
        "interval": 2,
        "tooltip": true
    }
}
